# Runtime (downloaded by setup-runtime.bat)
_runtime/

# Generated output (PDF + intermediate HTML/assets)
output/*

# Keep the output dir itself (with .gitkeep)
!output/.gitkeep

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Build artifacts
*.log
